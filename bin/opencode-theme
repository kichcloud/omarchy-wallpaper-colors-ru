#!/usr/bin/env python3
"""Синхронизирует тему OpenCode с палитрой активной темы Omarchy.

OpenCode в режиме `system` на каждую сессию заново делает OSC-запрос к
терминалу. При прозрачном foot часть запросов не успевает — сессия получает
тему по умолчанию вместо нашей, и вкладки «чередуются». Поэтому генерируем
полноценную тему и закрепляем её в cli.json: детекция больше не запускается.
"""
import json
import tomllib
from pathlib import Path

home = Path.home()
state = home / ".local/state/opencode/latest/tui"
config_dir = home / ".config/opencode"
colors_file = home / ".local/state/omarchy/current/theme/colors.toml"
theme_file = config_dir / "themes/wallpaper-glass.json"
cli_file = config_dir / "cli.json"
system_theme = state / "system-theme.json"

if not colors_file.exists():
    raise SystemExit(0)
try:
    c = tomllib.loads(colors_file.read_text())
except Exception:
    raise SystemExit(0)

get = lambda k, d: c.get(k, d)


def mix(a, b, t):
    """Смешивает два hex-цвета: t=0 → a, t=1 → b."""
    a, b = a.lstrip("#"), b.lstrip("#")
    return "#" + "".join(
        f"{round(int(a[i:i+2], 16) * (1 - t) + int(b[i:i+2], 16) * t):02x}"
        for i in (0, 2, 4)
    )


bg = get("background", "#1b1c21")
fg = get("foreground", "#e4e2e6")
red = get("red", "#ee7791")
green = get("green", "#7ce99a")
yellow = get("yellow", "#ebf087")
blue = get("blue", "#709eed")
magenta = get("magenta", "#c87aeb")
cyan = get("cyan", "#74d4ea")
orange = get("bright_orange", get("yellow", yellow))
muted = mix(bg, fg, 0.45)
panel = mix(bg, fg, 0.06)
element = mix(bg, fg, 0.11)
border = mix(bg, fg, 0.22)

# Полная карта токенов темы OpenCode.
palette = {
    "primary": blue,
    "secondary": cyan,
    "accent": magenta,
    "error": red,
    "warning": yellow,
    "success": green,
    "info": cyan,
    "text": fg,
    "textMuted": muted,
    "background": bg,
    "backgroundPanel": panel,
    "backgroundElement": element,
    "border": border,
    "borderActive": mix(bg, fg, 0.32),
    "borderSubtle": mix(bg, fg, 0.16),
    "diffAdded": green,
    "diffRemoved": red,
    "diffContext": muted,
    "diffHunkHeader": muted,
    "diffHighlightAdded": mix(panel, green, 0.35),
    "diffHighlightRemoved": mix(panel, red, 0.35),
    "diffAddedBg": mix(bg, green, 0.12),
    "diffRemovedBg": mix(bg, red, 0.12),
    "diffContextBg": panel,
    "diffLineNumber": muted,
    "diffAddedLineNumberBg": mix(bg, green, 0.12),
    "diffRemovedLineNumberBg": mix(bg, red, 0.12),
    "markdownText": fg,
    "markdownHeading": blue,
    "markdownLink": blue,
    "markdownLinkText": cyan,
    "markdownCode": green,
    "markdownBlockQuote": muted,
    "markdownEmph": yellow,
    "markdownStrong": orange,
    "markdownHorizontalRule": muted,
    "markdownListItem": blue,
    "markdownListEnumeration": cyan,
    "markdownImage": blue,
    "markdownImageText": cyan,
    "markdownCodeBlock": fg,
    "syntaxComment": muted,
    "syntaxKeyword": magenta,
    "syntaxFunction": blue,
    "syntaxVariable": red,
    "syntaxString": green,
    "syntaxNumber": orange,
    "syntaxType": yellow,
    "syntaxOperator": cyan,
    "syntaxPunctuation": fg,
}

theme = {
    "$schema": "https://opencode.ai/theme.json",
    "defs": {f"c{i}": v for i, v in enumerate(dict.fromkeys(palette.values()), 1)},
    "theme": {k: {"dark": v, "light": v} for k, v in palette.items()},
}


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    tmp.replace(path)


# Полноценная закреплённая тема.
write_json(theme_file, theme)

# Держим system-theme в актуальном состоянии на случай,
# если пользователь временно переключится на «system».
ansi = [bg, red, green, yellow, blue, magenta, cyan, fg,
        mix(bg, fg, 0.3), get("bright_red", red), get("bright_green", green),
        get("bright_yellow", yellow), get("bright_blue", blue),
        get("bright_magenta", magenta), get("bright_cyan", cyan),
        get("bright_foreground", "#ffffff")]
try:
    existing = json.loads(system_theme.read_text())
    colors = existing.get("colors", {}) if isinstance(existing, dict) else {}
except Exception:
    colors = {}
colors.update({
    "palette": ansi,
    "defaultForeground": fg,
    "defaultBackground": bg,
    "cursorColor": fg,
    "highlightBackground": get("selection", blue),
    "highlightForeground": get("selection_foreground", fg),
})
write_json(system_theme, {"colors": colors})

# Закрепляем тему в cli.json, сохраняя остальные пользовательские настройки.
try:
    cli = json.loads(cli_file.read_text())
except Exception:
    cli = {}
cli.setdefault("theme", {})
cli["theme"]["name"] = "wallpaper-glass"
cli["theme"]["mode"] = "dark"
write_json(cli_file, cli)
