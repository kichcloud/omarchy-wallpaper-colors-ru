#!/usr/bin/env bash
# Переключатель стиля и глобальные ползунки прозрачности/блюра.
# Вызывается кнопками и слайдерами в панели «Цвета обоев».
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ST=~/.local/state/omarchy/uniform-glass
mkdir -p "$ST"
mode=${1:-status}

style=$(cat "$ST/style" 2>/dev/null || true)
[[ $style == opaque || $style == glass ]] || style=glass
alpha_file="$ST/alpha"
blur_file="$ST/blur"

if [[ $mode == status ]]; then
  echo "$style"
  exit 0
fi

# Текущие значения для панели: JSON.
if [[ $mode == values ]]; then
  a=$(cat "$alpha_file" 2>/dev/null || true)
  [[ -n $a ]] || a=$( [[ $style == opaque ]] && echo 1.0 || echo 0.85 )
  b=$(cat "$blur_file" 2>/dev/null || echo 4)
  jq -nc --argjson a "$a" --argjson b "$b" '{alpha:$a, blur:$b}'
  exit 0
fi

# Ползунок прозрачности: 0.30 … 1.0.
if [[ $mode == alpha ]]; then
  v=${2:-}
  [[ $v =~ ^0?\.[0-9]+$ || $v =~ ^1(\.0+)?$ ]] || { echo "usage: glass-style alpha 0.30..1.0" >&2; exit 2; }
  python3 -c 'import sys; v=float(sys.argv[1]); sys.exit(0 if 0.30<=v<=1.0 else 1)' "$v" || exit 2
  printf '%s\n' "$v" >"$alpha_file"
  "$ROOT/bin/install-config" "$v" >/dev/null 2>&1 || true
  exit 0
fi

# Ползунок блюра: 0 … 30.
if [[ $mode == blur ]]; then
  v=${2:-}
  [[ $v =~ ^[0-9]+$ ]] && (( v <= 30 )) || { echo "usage: glass-style blur 0..30" >&2; exit 2; }
  printf '%s\n' "$v" >"$blur_file"
  hyprctl reload >/dev/null 2>&1 || true
  exit 0
fi

[[ $mode == glass || $mode == opaque ]] || { echo "usage: glass-style [glass|opaque|status|values|alpha <v>|blur <n>]" >&2; exit 2; }

# glass → window-glassy/0.85, opaque → window-opaque/1.0
bg=glassy; alpha=0.85
if [[ $mode == opaque ]]; then
  bg=opaque; alpha=1.0
fi
printf '%s\n' "$mode" >"$ST/style"
rm -f "$alpha_file"   # переключатель стиля сбрасывает ручную прозрачность

# Гарантируем, что все конфиги плагина на месте (в т.ч. на новой машине).
"$ROOT/bin/install-config" "$alpha" >/dev/null 2>&1 || true

T=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr
rm -f "$T/window-glassy.lua" "$T/window-opaque.lua"
src=${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr/toggles/window-$bg.lua
[[ -f $src ]] && cp "$src" "$T/$(basename "$src")"
omarchy-theme-set-glass >/dev/null 2>&1 || true

theme=$(cat ~/.local/state/omarchy/current/theme.name 2>/dev/null || true)
for f in ~/.config/foot/foot.ini ~/.config/omarchy/themes/"$theme"/foot.ini; do
  [[ -f $f ]] || continue
  sed -i -E "s/^([[:space:]]*alpha[[:space:]]*=[[:space:]]*).*/\1$alpha/" "$f"
done

hyprctl reload >/dev/null 2>&1 || true
omarchy restart shell >/dev/null 2>&1 || true
