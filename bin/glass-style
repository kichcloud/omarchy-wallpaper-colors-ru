#!/usr/bin/env bash
# Переключатель стиля и глобальные ползунки прозрачности/блюра.
# Вызывается кнопками и слайдерами в панели «Цвета обоев».
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/bin/common.sh"

ST=$STATE_DIR
mkdir -p "$ST"
mode=${1:-status}

style=$(glass_style)
alpha_file=$ST/glass-alpha
blur_file=$ST/glass-blur

cmd_status() {
  echo "$style"
}

cmd_values() {
  jq -nc --argjson a "$(glass_alpha "$style")" --argjson b "$(glass_blur)" '{alpha:$a, blur:$b}'
}

cmd_alpha() {
  local v=${1:-}
  valid_alpha_syntax "$v" || { echo "usage: glass-style alpha 0.30..1.0" >&2; exit 2; }
  valid_alpha_range "$v" || exit 2
  # В штатном стиле ползунки скрыты; запоздавший процесс от ползунка не должен
  # превратить непрозрачный стиль в прозрачный.
  [[ $style == opaque ]] && return 0
  printf '%s\n' "$v" >"$alpha_file"
  foot_set_alpha
  # Оболочка сама следит за shell.toml — полная смена темы не нужна.
  "$ROOT/bin/install-config" --light "$v" >/dev/null 2>&1 || true
}

cmd_blur() {
  local v=${1:-} fb=no
  valid_blur "$v" || { echo "usage: glass-style blur 0..30" >&2; exit 2; }
  printf '%s\n' "$v" >"$blur_file"
  # Композитор отключает блюр при A=1.0, поэтому foot тоже не должен размывать.
  [[ $style == glass ]] && (( v > 0 )) && fb=yes
  foot_set_blur "$fb"
  reload_hypr
}

cmd_style() {
  local s=$1 alpha
  alpha=$(glass_default_alpha "$s")
  printf '%s\n' "$s" >"$ST/glass-style"
  rm -f "$alpha_file"   # переключатель стиля сбрасывает ручную прозрачность
  # Тумблер окон, конфиги и хуки ставит install-config.
  "$ROOT/bin/install-config" "$alpha" >/dev/null 2>&1 || true
  # Перезапуск оболочки не нужен: ~/.config/omarchy/shell.toml читается ей вживую.
  foot_set_alpha
  reload_hypr
}

case $mode in
  status)  cmd_status ;;
  values)  cmd_values ;;
  alpha)   cmd_alpha "${2:-}" ;;
  blur)    cmd_blur "${2:-}" ;;
  glass|opaque) cmd_style "$mode" ;;
  *) echo "usage: glass-style [glass|opaque|status|values|alpha <v>|blur <n>]" >&2; exit 2 ;;
esac
