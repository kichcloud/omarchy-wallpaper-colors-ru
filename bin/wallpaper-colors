#!/bin/bash
# Перекрашивает активную тему Omarchy по цветам обоев.
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
source "$here/common.sh"
state=$STATE_DIR
cur=$CURRENT_DIR
themes=$HOME/.config/omarchy/themes
picks=$state/picks.json
off=$state/off
modef=$state/mode
marker="# Written by the Wallpaper Colors plugin. Choose Theme default in its bar popup to remove it."
tmp=
mkdir -p "$state"; touch "$off"
trap '[[ $tmp ]] && rm -f "$tmp"' EXIT

need_matugen() {
  command -v matugen >/dev/null && return
  local m=${XDG_RUNTIME_DIR:-/tmp}/wallpaper-colors-matugen-missing
  [[ -e $m ]] || {
    touch "$m"
    omarchy-notification-send -u critical "Wallpaper Colors needs matugen" "Install matugen from the Arch extra repository"
  }
  echo "matugen is not installed" >&2; exit 1
}

# Исходные цвета обоев: один формат разбора для панели и проверки индекса pick.
source_colors() {
  matugen image "$image" --show-source-colors --dry-run --json hex 2>/dev/null |
    grep -E '^#[0-9a-fA-F]{6}$'
}

# Оба значения читаются под одной блокировкой с omarchy theme set.
read_current() {
  exec 8>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-theme-set.lock"; flock 8
  theme=$(<"$cur/theme.name"); image=$(readlink -e "$cur/background"); exec 8>&-
  if [[ $image == "$cur/theme/"* ]]; then
    local root
    for root in "$themes" /usr/share/omarchy/themes; do
      [[ -f $root/$theme/${image#"$cur/theme/"} ]] && { image=$root/$theme/${image#"$cur/theme/"}; break; }
    done
  fi
}

# Мутации палитры сериализуются, чтобы два sync не писали colors.toml одновременно.
lock_and_read() {
  exec 9>"$state/lock"; flock 9; read_current
}

from_git()   { [[ ! -L $themes/$theme && -d $themes/$theme/.git ]]; }
backup_path() { printf '%s/backup.%s.colors.toml\n' "$state" "$theme"; }
is_off()     { grep -qxF "$theme" "$off"; }
ours()       { [[ -f $1 ]] && [[ $(head -n1 "$1") == "$marker" ]]; }
picked()     { jq -r --arg i "$image" '.[$i] // 0' "$picks" 2>/dev/null || echo 0; }
reapply() {
  OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$theme" >/dev/null
  # Курсор и OpenCode перекрашиваются тут же, без отдельного плагина и хуков.
  apply_tools "$here/.."
}

# Принудительный режим из $modef, иначе порог яркости 0.6.
mode_for() {
  [[ -f $modef ]] && {
    local forced; read -r forced <"$modef"
    case $forced in dark|light) echo "$forced"; return;; esac
  }
  (( $(magick "$1[0]" -resize 64x64! -colorspace Gray -format '%[fx:mean > 0.6]' info:) )) && echo light || echo dark
}

sync_locked() {
  is_off || from_git && return
  need_matugen
  local target=$themes/$theme/colors.toml mode; mode=$(mode_for "$image")
  mkdir -p "$themes/$theme"
  [[ -f $target ]] && ! ours "$target" && cp "$target" "$(backup_path)"
  tmp=$(mktemp "$themes/$theme/.colors.toml.XXXXXX")
  {
    echo "$marker"
    matugen image "$image" --dry-run --mode "$mode" --source-color-index "$(picked)" --json hex |
      jq -r --arg mode "$mode" -f "$here/colors.jq"
  } >"$tmp"
  cmp -s "$tmp" "$target" && rm -f "$tmp" || { mv "$tmp" "$target"; reapply; }
}

sync() {
  lock_and_read
  sync_locked
}

reset() {
  lock_and_read
  is_off || echo "$theme" >>"$off"
  from_git && return
  local target=$themes/$theme/colors.toml
  ours "$target" || return
  if [[ -f $(backup_path) ]]; then
    mv "$(backup_path)" "$target"
  elif [[ -f $here/../themes/$theme/colors.toml ]]; then
    # У собственной темы плагина нет стокового бэкапа — возвращаем цвета,
    # с которыми она поставляется, а не оставляем тему без палитры вообще.
    cp "$here/../themes/$theme/colors.toml" "$target"
  else
    rm "$target"; rmdir --ignore-fail-on-non-empty "$themes/$theme"
  fi
  reapply
}

# Один просмотр изображения + дешёвые matugen color вместо N просмотров.
sources() {
  read_current
  if from_git; then
    jq -nc --arg t "$theme" '{theme:$t,locked:true,active:-1,mode:"auto",colors:[]}'; return
  fi
  need_matugen
  local mode c colors; mode=$(mode_for "$image")
  colors=$(
    source_colors |
      while read -r c; do
        matugen color hex "$c" --dry-run --mode "$mode" --json hex 2>/dev/null |
          jq -r --arg m "$mode" '.colors.primary[$m].color'
      done | jq -Rsc 'split("\n") | map(select(length > 0))'
  )
  jq -nc --arg t "$theme" --argjson a "$(is_off && echo -1 || picked)" \
    --arg m "$mode" --argjson c "$colors" \
    '{theme:$t,locked:false,active:$a,mode:$m,colors:$c}'
}

source_count() {
  source_colors | wc -l || true
}

pick() {
  local n=${1:-}
  [[ $n =~ ^[0-9]+$ ]] || { echo "Использование: wallpaper-colors pick <индекс>" >&2; return 2; }
  lock_and_read
  need_matugen
  local max; max=$(source_count)
  (( max > 0 && n < max )) || { echo "Нет цвета с индексом $n (доступно $max)" >&2; return 2; }
  tmp=$(mktemp "$state/.off.XXXXXX"); grep -vxF "$theme" "$off" >"$tmp" || true; mv "$tmp" "$off"
  tmp=$(mktemp "$state/.picks.XXXXXX")
  if [[ $n == 0 ]]; then
    jq --arg i "$image" 'del(.[$i])' "$picks" 2>/dev/null >"$tmp" || echo '{}' >"$tmp"
  else
    jq --arg i "$image" --argjson n "$n" '.[$i] = $n' "$picks" 2>/dev/null >"$tmp" ||
      jq -n --arg i "$image" --argjson n "$n" '{($i): $n}' >"$tmp"
  fi
  mv "$tmp" "$picks"; tmp=""; sync_locked
}

setmode() {
  case ${1:-} in
    "") [[ -f $modef ]] && cat "$modef" || echo auto ;;
    auto) rm -f "$modef"; sync ;;
    dark|light) printf '%s\n' "$1" >"$modef"; sync ;;
    *) echo "Использование: wallpaper-colors mode [auto|dark|light]" >&2; exit 1 ;;
  esac
}

case ${1:-sync} in
  sync) sync ;;
  sources) sources ;;
  pick) pick "${2:?pick needs an index}" ;;
  reset) reset ;;
  mode) setmode "${2:-}" ;;
  *) echo "Использование: wallpaper-colors [sync|sources|pick <n>|reset|mode <auto|dark|light>]" >&2; exit 1 ;;
esac
