#!/usr/bin/env bash
# Ставит пользовательские конфиги, от которых зависит внешний вид плагина.
# Идемпотентно: можно вызывать при каждом запуске/переключении стиля.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
HOME_DIR=${HOME:-/home/kich}
source "$ROOT/bin/common.sh"

THEME=wallpaper-glass
DEST=$HOME_DIR/.config/omarchy/themes/$THEME
MARK=$DEST/.installed-by-wallpaper-colors
LOCK_DIR=$HOME_DIR/.config/omarchy/lock-designs
LOCK_ID=my-wallpaperglass

style=$(cat "$STATE_DIR/glass-style" 2>/dev/null || true)
default_alpha=$(cat "$STATE_DIR/glass-alpha" 2>/dev/null || true)
valid_alpha_value "$default_alpha" || {
  default_alpha=0.85
  [[ $style == opaque ]] && default_alpha=1.0
}
alpha=${1:-$default_alpha}
# Аргумент от ползунка тоже проверяем: битое значение не должно попасть в shell.toml.
valid_alpha_value "$alpha" || alpha=$default_alpha

# Обновление только альфы оболочки: shell.toml читается ей вживую, поэтому
# ползунку не нужны ни смена темы, ни ретинат приложений, ни рестарт оболочки.
shell_alpha() {
python3 - "$HOME_DIR" "$alpha" <<'PY'
import re, sys, pathlib
home = pathlib.Path(sys.argv[1]); alpha = sys.argv[2]
p = home / ".config/omarchy/shell.toml"
text = p.read_text() if p.exists() else ""
for s in ("bar", "popups", "tooltip", "notifications", "launcher", "menu", "polkit", "lock"):
    pat = re.compile(r"(?ms)^\[" + s + r"\][ \t]*\n(.*?)(?=^\[|\Z)")
    body = f"background-alpha = {alpha}\n"
    if pat.search(text):
        text = pat.sub(lambda m: f"[{s}]\n" + body +
                       re.sub(r"^background-alpha[ \t]*=.*\n?", "", m.group(1), flags=re.M),
                       text, count=1)
    else:
        text += f"\n[{s}]\n" + body
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(text)
PY
}

# Альфа поверхностей Vesktop из того же ползунка, что и у всех остальных.
vesktop_alpha() {
  local data=$HOME_DIR/.local/share/omarchy-glass
  mkdir -p "$data"
  printf ':root {\n  --oc-s0: rgba(var(--oc-bg-rgb), %s) !important;\n  --oc-s1: rgba(var(--oc-bg-rgb), %s) !important;\n  --oc-s2: rgba(var(--oc-bg-rgb), %s) !important;\n  --oc-s3: rgba(var(--oc-bg-rgb), %s) !important;\n  --oc-s4: rgba(var(--oc-bg-rgb), %s) !important;\n}\n' \
    "$alpha" "$alpha" "$alpha" "$alpha" "$alpha" >"$data/alpha.css"
  bash "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass" \
    "$(cat "$CURRENT_DIR/theme.name" 2>/dev/null || echo wallpaper-glass)" >/dev/null 2>&1 || true
}

if [[ ${1:-} == --light ]]; then
  alpha=${2:-$default_alpha}
  valid_alpha_value "$alpha" || alpha=$default_alpha
  shell_alpha
  vesktop_alpha
  # Lua-конфиг Hyprland читает именно этот файл — держим его в синхроне с shell.toml.
  printf '%s\n' "$alpha" >"$STATE_DIR/glass-alpha"
  reload_hypr
  exit 0
fi

migrate_state() {
  local old=$HOME_DIR/.local/state/omarchy/uniform-glass k
  if [[ -d $old ]]; then
    for k in style alpha blur; do
      [[ -f $old/$k ]] && mv "$old/$k" "$STATE_DIR/glass-$k"
    done
    rmdir "$old" 2>/dev/null || true
  fi
  old=$STATE_DIR/backups
  if [[ -d $old ]]; then
    local f
    for f in "$old"/*; do
      [[ -f $f ]] && mv "$f" "$STATE_DIR/backup.$(basename "$f")"
    done
    rmdir "$old" 2>/dev/null || true
  fi
  old=$STATE_DIR/cursor
  [[ -f $old/.lock ]] && mv "$old/.lock" "$STATE_DIR/cursor.lock"
  rmdir "$old" 2>/dev/null || true
}

deploy_assets() {
  cp "$ROOT/assets/omarchy/omarchy-glass.palette.css.tpl" \
     "$HOME_DIR/.config/omarchy/themed/omarchy-glass.palette.css.tpl"
  mkdir -p "$HOME_DIR/.local/share/omarchy-glass"
  cp "$ROOT/assets/glass/style.css" "$HOME_DIR/.local/share/omarchy-glass/style.css"

  mkdir -p "$HOME_DIR/.config/omarchy/hooks/theme-set.d"
  cp "$ROOT/assets/hooks/omarchy-glass" "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass"
  chmod +x "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass"

  # Единая прозрачность и блюр для всех окон.
  cp "$ROOT/assets/omarchy/uniform-glass.lua" "$HOME_DIR/.config/hypr/uniform-glass.lua"
  local hl=$HOME_DIR/.config/hypr/hyprland.lua
  grep -q 'require("hypr.uniform-glass")' "$hl" 2>/dev/null || \
    printf '\nrequire("hypr.uniform-glass") -- uniform transparency + blur for every window and layer\n' >>"$hl"
}

configure_vesktop() {
  local vs=$HOME_DIR/.config/vesktop/settings/settings.json tmp
  [[ -f $vs ]] && command -v jq >/dev/null || return 0
  tmp=$(mktemp)
  if jq '.enabledThemes = ["omarchy-glass.theme.css"] | .transparent = true' "$vs" >"$tmp"; then
    mv "$tmp" "$vs"
  else
    rm -f "$tmp"
  fi
}

configure_steam() {
  # CEF Whisper Wrap нужен только для живой инъекции CSS через локальный CDP.
  mkdir -p "$HOME_DIR/.steam/steam" "$HOME_DIR/.local/bin"
  touch "$HOME_DIR/.steam/steam/.cef-enable-remote-debugging"
  local src=$ROOT/assets/steam/steam-accent.py dst=$HOME_DIR/.local/bin/steam-accent
  [[ -f $src ]] || return 0
  install -m755 "$src" "$dst"
}

configure_osd() {
  # OSD встроен в этот плагин — стоковый и старый клон больше не нужны.
  omarchy plugin disable kich.osd >/dev/null 2>&1 || true
  omarchy plugin disable omarchy.osd >/dev/null 2>&1 || true
}

configure_window_toggle() {
  # Синхронизировать тумблер окон со стилем — иначе foot теряет blur=yes.
  local t=${XDG_STATE_HOME:-$HOME_DIR/.local/state}/omarchy/toggles/hypr
  local wmode=glassy wsrc
  [[ $style == opaque ]] && wmode=opaque
  rm -f "$t/window-glassy.lua" "$t/window-opaque.lua"
  wsrc=${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr/toggles/window-$wmode.lua
  [[ -f $wsrc ]] && cp "$wsrc" "$t/$(basename "$wsrc")"
  omarchy-theme-set-glass >/dev/null 2>&1 || true
}

install_theme() {
  # Рабочий стол: тема рядом со стоковыми, в штатной карусели.
  if [[ ! -f $MARK ]]; then
    mkdir -p "$DEST"
    cp -a "$ROOT/themes/$THEME/." "$DEST/"
    printf 'installed by kich.wallpaper-colors-ru\n' >"$MARK"
    # Не трогаем текущие обои пользователя, только включаем тему.
    OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$THEME" >/dev/null 2>&1 || true
    "$ROOT/bin/wallpaper-colors" sync >/dev/null 2>&1 || true
  fi
  # Превью обновляем всегда: без preview-unlock.png темы нет в карусели,
  # а unlock.png использует сам Plymouth.
  cp "$ROOT/themes/$THEME/preview-unlock.png" "$DEST/preview-unlock.png"
  cp "$ROOT/themes/$THEME/unlock.png" "$DEST/unlock.png"
}

install_lock() {
  [[ -f $LOCK_DIR/WallpaperGlass.qml ]] && return 0
  mkdir -p "$LOCK_DIR"
  cp "$ROOT/lock/WallpaperGlass.qml" "$LOCK_DIR/WallpaperGlass.qml"
  mkdir -p "$LOCK_DIR/thirdparty-previews"
  cp "$ROOT/lock/preview/my-wallpaperglass.jpg" \
     "$LOCK_DIR/thirdparty-previews/my-wallpaperglass.jpg"
  local settings=$LOCK_DIR/settings.json tmp
  if [[ -f $settings ]] && command -v jq >/dev/null; then
    tmp=$(mktemp)
    if jq --arg id "$LOCK_ID" '.design = $id' "$settings" >"$tmp"; then
      mv "$tmp" "$settings"
    else
      rm -f "$tmp"
    fi
  else
    printf '{\n  "design": "%s"\n}\n' "$LOCK_ID" >"$settings"
  fi
}

refresh_theme() {
  # Пересобрать палитру/тему под новые шаблоны.
  THEME_NAME=$(cat "$CURRENT_DIR/theme.name" 2>/dev/null || true)
  [[ -n $THEME_NAME ]] || THEME_NAME=$THEME
  OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$THEME_NAME" >/dev/null 2>&1 || true
  # omarchy theme set может не дёрнуть хуки, если тема не менялась — вызываем
  # генератор темы Vesktop явно, чтобы CSS всегда соответствовал ассетам.
  bash "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass" "$THEME_NAME" >/dev/null 2>&1 || true
  reload_hypr
}

restore_blur() {
  # Хуки темы выше всегда пишут blur=yes. Если пользователь выключил блюр
  # ползунком, возвращаем сохранённое значение — последним шагом.
  local blurv
  blurv=$(cat "$STATE_DIR/glass-blur" 2>/dev/null || true)
  if [[ $blurv =~ ^[0-9]+$ ]] && (( blurv == 0 )); then
    foot_set_blur no
  fi
}

migrate_state
deploy_assets
shell_alpha
vesktop_alpha
configure_vesktop
configure_steam
configure_osd
configure_window_toggle
omarchy-bar background opaque >/dev/null 2>&1 || true
install_theme
install_lock
refresh_theme
apply_tools "$ROOT"
restore_blur
