#!/usr/bin/env bash
# Ставит пользовательские конфиги, от которых зависит внешний вид плагина:
# палитру Vesktop, CSS стекла, хук темы, альфу оболочки и Hyprland.
# Идемпотентно: можно вызывать при каждом запуске/переключении стиля.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
HOME_DIR=${HOME:-/home/kich}

# По умолчанию берём альфу из текущего стиля: иначе рестарт оболочки
# (Service.qml вызывает install-config без аргументов) сбросил бы 1.0 → 0.85.
style=$(cat "$HOME_DIR/.local/state/omarchy/uniform-glass/style" 2>/dev/null || true)
default_alpha=0.85
[[ $style == opaque ]] && default_alpha=1.0
alpha=${1:-$default_alpha}

cp "$ROOT/assets/omarchy/omarchy-glass.palette.css.tpl" \
   "$HOME_DIR/.config/omarchy/themed/omarchy-glass.palette.css.tpl"
mkdir -p "$HOME_DIR/.local/share/omarchy-glass"
cp "$ROOT/assets/glass/style.css" "$HOME_DIR/.local/share/omarchy-glass/style.css"

mkdir -p "$HOME_DIR/.config/omarchy/hooks/theme-set.d"
cp "$ROOT/assets/hooks/omarchy-glass" "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass"
chmod +x "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass"

# Единая прозрачность и блюр для всех окон.
cp "$ROOT/assets/omarchy/uniform-glass.lua" "$HOME_DIR/.config/hypr/uniform-glass.lua"
HL="$HOME_DIR/.config/hypr/hyprland.lua"
grep -q 'require("hypr.uniform-glass")' "$HL" 2>/dev/null || \
  printf '\nrequire("hypr.uniform-glass") -- uniform transparency + blur for every window and layer\n' >>"$HL"

# Альфа панелей оболочки: точечно обновляем известные секции, остальное сохраняем.
python3 - "$HOME_DIR" "$alpha" <<'PY'
import re, sys, pathlib
home = pathlib.Path(sys.argv[1])
alpha = sys.argv[2]
p = home / ".config/omarchy/shell.toml"
text = p.read_text() if p.exists() else ""
for s in ("bar", "popups", "tooltip", "notifications", "launcher", "menu", "polkit", "lock"):
    pat = re.compile(r"(?ms)^\[" + s + r"\][ \t]*\n(.*?)(?=^\[|\Z)")
    body = f"background-alpha = {alpha}\n"
    if pat.search(text):
        text = pat.sub(lambda m: f"[{s}]\n" + body +
                       re.sub(r"^background-alpha[ \t]*=.*\n?", "", m.group(1), flags=re.M),
                       text, count=1)
    else:
        text += f"\n[{s}]\n" + body
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(text)
PY

# Vesktop: наша тема и непрозрачное содержимое (альфу даёт композитор, как у folio).
VS="$HOME_DIR/.config/vesktop/settings/settings.json"
if [[ -f $VS ]] && command -v jq >/dev/null; then
  tmp=$(mktemp)
  jq '.enabledThemes = ["omarchy-glass.theme.css"] | .transparent = false' "$VS" >"$tmp" && mv "$tmp" "$VS"
fi

# OSD встроен в этот плагин — стоковый и старый клон больше не нужны.
omarchy plugin disable kich.osd >/dev/null 2>&1 || true
omarchy plugin disable omarchy.osd >/dev/null 2>&1 || true

# Бар: сплошная поверхность, как у остальных окон (не glassy).
omarchy-bar background opaque >/dev/null 2>&1 || true

THEME=wallpaper-glass
DEST="$HOME/.config/omarchy/themes/$THEME"
MARK="$DEST/.installed-by-wallpaper-colors"
LOCK_DIR="$HOME/.config/omarchy/lock-designs"
LOCK_ID=my-wallpaperglass

# Рабочий стол: тема рядом со стоковыми, в штатной карусели.
if [[ ! -f $MARK ]]; then
  mkdir -p "$DEST"
  cp -a "$ROOT/themes/$THEME/." "$DEST/"
  printf 'installed by kich.wallpaper-colors-ru\n' >"$MARK"
  # Не трогаем текущие обои пользователя, только включаем тему.
  OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$THEME" >/dev/null 2>&1 || true
  "$ROOT/bin/wallpaper-colors" sync >/dev/null 2>&1 || true
fi

# Превью обновляем всегда: без preview-unlock.png темы нет в карусели
# omarchy-plymouth-switcher, а unlock.png использует сам Plymouth.
cp "$ROOT/themes/$THEME/preview-unlock.png" "$DEST/preview-unlock.png"
cp "$ROOT/themes/$THEME/unlock.png" "$DEST/unlock.png"

# Lock: стандартный макет с цветами и обоями от плагина.
if [[ ! -f $LOCK_DIR/WallpaperGlass.qml ]]; then
  mkdir -p "$LOCK_DIR"
  cp "$ROOT/lock/WallpaperGlass.qml" "$LOCK_DIR/WallpaperGlass.qml"
  mkdir -p "$LOCK_DIR/thirdparty-previews"
  cp "$ROOT/lock/preview/my-wallpaperglass.jpg" \
     "$LOCK_DIR/thirdparty-previews/my-wallpaperglass.jpg"
  settings="$LOCK_DIR/settings.json"
  if [[ -f $settings ]] && command -v jq >/dev/null; then
    tmp=$(mktemp)
    jq --arg id "$LOCK_ID" '.design = $id' "$settings" >"$tmp" && mv "$tmp" "$settings"
  else
    printf '{\n  "design": "%s"\n}\n' "$LOCK_ID" >"$settings"
  fi
fi

# Пересобрать палитру/тему под новые шаблоны.
THEME_NAME=$(cat "$HOME_DIR/.local/state/omarchy/current/theme.name" 2>/dev/null || true)
[[ -n $THEME_NAME ]] || THEME_NAME=wallpaper-glass
if [[ -f "$ROOT/bin/wallpaper-colors" ]]; then
  OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$THEME_NAME" >/dev/null 2>&1 || true
fi
# omarchy theme set может не дёрнуть хуки, если тема не менялась — вызываем
# генератор темы Vesktop явно, чтобы CSS всегда соответствовал ассетам.
bash "$HOME_DIR/.config/omarchy/hooks/theme-set.d/omarchy-glass" "$THEME_NAME" >/dev/null 2>&1 || true
hyprctl reload >/dev/null 2>&1 || true
